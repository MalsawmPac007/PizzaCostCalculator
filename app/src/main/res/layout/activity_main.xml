<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:paddingBottom="48dp">


        <ImageView
            android:id="@+id/ivPizza"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginBottom="16dp"
            android:contentDescription="@string/pizza_image_description"
            android:scaleType="centerCrop"
            android:src="@drawable/pizza" />


        <EditText
            android:id="@+id/etPizzaCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginBottom="16dp"
            android:hint="@string/hint_pizza_count"
            android:inputType="number" />


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/label_select_size"
            android:textStyle="bold"
            android:textSize="16sp" />

        <RadioGroup
            android:id="@+id/rgSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/rbSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/size_small" />

            <RadioButton
                android:id="@+id/rbMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/size_medium" />

            <RadioButton
                android:id="@+id/rbLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/size_large" />

            <RadioButton
                android:id="@+id/rbExtraLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/size_extra_large" />

        </RadioGroup>


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/label_select_toppings"
            android:textStyle="bold"
            android:textSize="16sp" />

        <CheckBox
            android:id="@+id/cbBacon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/topping_bacon" />

        <CheckBox
            android:id="@+id/cbBananaPeppers"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/topping_banana_peppers" />

        <CheckBox
            android:id="@+id/cbGrilledChicken"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/topping_grilled_chicken" />

        <CheckBox
            android:id="@+id/cbGroundBeef"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/topping_ground_beef" />

        <CheckBox
            android:id="@+id/cbMushroom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/topping_mushroom" />

        <CheckBox
            android:id="@+id/cbPepperoni"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/topping_pepperoni" />

        <CheckBox
            android:id="@+id/cbExtraCheese"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/topping_extra_cheese" />

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnClear"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="@string/btn_clear" />

            <Button
                android:id="@+id/btnCalculate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/btn_calculate" />

        </LinearLayout>


        <TextView
            android:id="@+id/tvTotalCost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/total_cost_default"
            android:textStyle="bold"
            android:textSize="18sp"
            android:gravity="center" />

    </LinearLayout>

</ScrollView>